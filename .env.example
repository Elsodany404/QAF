# Copy to .env for local development, and set the same variables in your
# hosting provider's dashboard. Never commit real values.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle, so they must be
# set when the app is BUILT, not only when it runs.

# --- Site -------------------------------------------------------------------
# Public address of the site, e.g. https://qafcoffee.store. Used for auth
# email links, Paymob callbacks, the sitemap and allowed origins.
NEXT_PUBLIC_SITE_URL=

# --- Better Auth --------------------------------------------------------------
# Long random string, e.g. the output of: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Supabase -----------------------------------------------------------------
# Postgres connection string used by Better Auth. On serverless hosts (Vercel,
# Netlify) use the transaction pooler (port 6543); on a long-running server
# the session pooler (port 5432) is fine.
SUPABASE_CONNECTION_STRING=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security.
SUPABASE_SECRET_KEY=

# --- Paymob -------------------------------------------------------------------
# Live keys in production: egy_pk_test_ / egy_sk_test_ keys only take test
# cards. The integration ids differ between test and live too.
NEXT_PUBLIC_PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_KEY=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_MOBILE_WALLET_INTEGRATION_ID=

# --- Bosta --------------------------------------------------------------------
BOSTA_API_KEY=
# The value Bosta sends in the Authorization header of webhook calls.
BOSTA_SECRET_KEY=
BOSTA_BUSINESS_LOCATION_ID=
# Optional: who the courier asks for at a pickup. Leave name and phone empty
# to use the pickup location's default contact in Bosta. The phone must be
# an Egyptian mobile number (01xxxxxxxxx); the email is optional.
BOSTA_PICKUP_CONTACT_NAME=
BOSTA_PICKUP_CONTACT_PHONE=
BOSTA_PICKUP_CONTACT_EMAIL=

# --- Email ----------------------------------------------------------------------
# Set ONE of the two senders below. SMTP wins when both are set.
#
# SMTP: any mailbox with SMTP access. Emails anyone without verifying a
# domain, e.g. Gmail: turn on 2-Step Verification, create an app password at
# https://myaccount.google.com/apppasswords, then
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
#   SMTP_USER=you@gmail.com   SMTP_PASS=<16-character app password>
# Gmail sends up to about 500 emails a day.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional, defaults to SMTP_USER. Gmail only sends as your own address:
# Qaf Coffee <you@gmail.com>
SMTP_FROM=

# Resend: only emails other people once the domain is verified in Resend.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Qaf Coffee <orders@qafcoffee.store>
RESEND_FROM_EMAIL=

# Optional: where contact-form messages are delivered,
# and where customers' replies go. Defaults to sales@qafcoffee.store; set it
# when that mailbox can't receive mail.
SHOP_INBOX_EMAIL=
